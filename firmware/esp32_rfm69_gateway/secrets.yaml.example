# Copy to secrets.yaml (gitignored) and fill in, so `esphome run ewfa_gateway.yaml` works from
# this repo:
#
#   cp secrets.yaml.example secrets.yaml
#
# On Home Assistant these same keys live in /config/esphome/secrets.yaml, which the Device
# Builder config (creek-gateway.yaml) reads — that copy is the authoritative one. The first
# three are shared with the other ESPHome devices there; the last three are gateway-specific.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Fallback hotspot the gateway raises if it can't reach the AP. Minimum 8 characters.
ap_password: "fallback-password"

# openssl rand -base64 32
creek_gateway_api_key: "base64-32-bytes-here"
creek_gateway_ota_password: "your-ota-password"

# Must match the creek node's ENCRYPT_KEY exactly (16 chars, AES-128) —
# see firmware/moteino_creek_node/src/main.cpp and firmware/README.md "Configuration".
rfm69_encrypt_key: "sampleEncryptKey"
